# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Raw acquired source material — kept local.
# Provenance is recorded in docs/source_register/source_register.csv.
# Only the README and directory placeholders are tracked so the folder
# skeleton survives `git clone`.
data/raw/*
!data/raw/README.md
!data/raw/web/
!data/raw/pdf/
!data/raw/csv/
!data/raw/other/
data/raw/web/*
data/raw/pdf/*
data/raw/csv/*
data/raw/other/*
!data/raw/web/.gitkeep
!data/raw/pdf/.gitkeep
!data/raw/csv/.gitkeep
!data/raw/other/.gitkeep

# Intermediate / generated data — regenerable, kept local.
data/interim/*
!data/interim/README.md

# Python tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated binary artifacts
*.pkl
*.pickle
docs/source_register/*.bak-*.csv
